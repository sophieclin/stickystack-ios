// Copy this file to Secrets.xcconfig (gitignored) and fill in your Supabase
// project's values from Project Settings > API in the Supabase dashboard.
//
// The "$()" in the URL below is not a typo: xcconfig files treat "//" as a
// comment marker, so a literal "//" inside a value must be split with an
// empty macro expansion to survive.
SUPABASE_URL = https:/$()/your-project.supabase.co
SUPABASE_ANON_KEY = your-anon-key
